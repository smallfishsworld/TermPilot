# Copy to backend/.env and fill in what you need. Every key is optional unless noted.
# All settings use the TP_ prefix; see termpilot/settings.py for the full list.

# --- core -------------------------------------------------------------------
# "production" refuses to start without TP_SECRET_KEY.
TP_ENVIRONMENT=development
# Signs access tokens and encrypts stored campus cookies and mailbox codes.
# Generate one with: python -c "import secrets; print(secrets.token_urlsafe(48))"
TP_SECRET_KEY=
# SQLite by default; PostgreSQL example:
# TP_DATABASE_URL=postgresql+psycopg2://termpilot:termpilot@localhost:5432/termpilot
TP_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
TP_TIMEZONE=Asia/Shanghai

# Explore without a campus account: sign in as demo / demo, sample data, simulated mail.
TP_DEMO_MODE=false

# --- campus systems ------------------------------------------------------------
# TP_CAMPUS_SSO_URL=https://cas.sustech.edu.cn/cas/login
# TP_CAMPUS_LMS_URL=https://bb.sustech.edu.cn
# TP_CAMPUS_RECORDS_URL=https://tis.sustech.edu.cn
# Only if your network intercepts TLS:
# TP_CAMPUS_VERIFY_TLS=false
# First Monday of teaching for the whole deployment (students can override it in Settings):
# TP_TERM_START_OVERRIDE=2026-09-07

# --- assistant (any OpenAI-compatible chat API) ---------------------------------------
TP_LLM_BASE_URL=https://api.deepseek.com/v1
TP_LLM_API_KEY=
TP_LLM_CHAT_MODEL=deepseek-chat
TP_LLM_REASONING_MODEL=deepseek-reasoner

# --- document library ---------------------------------------------------------------
TP_EMBEDDING_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
TP_EMBEDDING_API_KEY=
TP_EMBEDDING_MODEL=text-embedding-v3
TP_EMBEDDING_DIMENSIONS=1024
# Optional rerank (DashScope text-rerank API).
TP_RERANK_API_KEY=
TP_SEARCH_URL=http://localhost:9200
TP_SEARCH_USERNAME=elastic
TP_SEARCH_PASSWORD=

# --- web search (serper.dev) -----------------------------------------------------------
TP_WEB_SEARCH_API_KEY=
